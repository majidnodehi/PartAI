# Short id for this running agent. Printed at startup, returned by
# GET /api/diagnostics, and sent on the X-Agent-Instance-Id header.
AGENT_INSTANCE_ID=k7m2qx

PORT=3000

# How many events to publish during each interval.
EVENT_COUNT=5

# How many seconds that interval lasts.
INTERVAL_SECONDS=1

EVENT_BUFFER_SIZE=512
WS_PATH=/events

# Seconds between publish stats logs. 0 disables the log.
LOG_EVERY_SECONDS=30

# Drop a slow subscriber's events while its socket buffer is above this size.
MAX_BUFFERED_BYTES=1048576

# Optional range overrides for the static metric enum.
# METRIC_DEFS=[{"name":"speed","min":0,"max":180,"fractionDigits":1}]
